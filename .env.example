# Fork testing only. The default `forge test` suite runs against local mocks and
# needs none of this.
#
# Interpolated into the [rpc_endpoints] aliases in foundry.toml, so that
# `forge test --fork-url ethereum|base|arbitrum|robinhood` resolves. See
# FORK_GUIDE.md.
ALCHEMY_API_KEY=your_alchemy_api_key_here
